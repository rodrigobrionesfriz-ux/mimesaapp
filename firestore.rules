rules_version = '2';

// Reglas de Mi Mesa.
// Principio: cada persona solo accede al hogar del que es miembro.
// La configuracion web de Firebase es publica; esto es lo que realmente protege los datos.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Es miembro del hogar segun la lista guardada en el propio documento del hogar.
    function esMiembro(hogarId) {
      return autenticado()
        && request.auth.uid in get(/databases/$(database)/documents/hogares/$(hogarId)).data.miembros;
    }

    // Cada usuario solo lee y escribe su propio registro.
    match /usuarios/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /hogares/{hogarId} {
      // get abierto a cualquier sesion iniciada: el ID del hogar es el codigo de
      // invitacion (aleatorio de 20 caracteres) y hay que poder leerlo para unirse.
      // list queda cerrado, asi nadie puede recorrer la lista de hogares.
      allow get: if autenticado();
      allow list: if false;

      // Crear: el creador debe incluirse a si mismo en la lista de miembros.
      allow create: if autenticado() && request.auth.uid in request.resource.data.miembros;

      // Unirse a un hogar existente: solo puede agregarse a si mismo y sin borrar a nadie.
      allow update: if autenticado()
        && request.resource.data.nombre == resource.data.nombre
        && request.resource.data.miembros.hasAll(resource.data.miembros)
        && request.resource.data.miembros.hasOnly(resource.data.miembros.concat([request.auth.uid]));

      allow delete: if false;

      // Contenido del hogar. Se declaran explícitamente las subcolecciones que usa
      // la app, además del comodín, para que quede claro qué se está permitiendo.
      match /semanas/{clave}      { allow read, write: if esMiembro(hogarId); }
      match /semanas_hija/{clave} { allow read, write: if esMiembro(hogarId); }
      match /historial/{id}       { allow read, write: if esMiembro(hogarId); }
      match /recetas/{id}         { allow read, write: if esMiembro(hogarId); }
      match /config/{id}          { allow read, write: if esMiembro(hogarId); }

      match /{documento=**} {
        allow read, write: if esMiembro(hogarId);
      }
    }
  }
}
